# Base de datos (obligatorio)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
# DB_SSLMODE=require
# DB_SSLROOTCERT=/path/to/ca.crt

# JWT / sesiones (obligatorio en todos los entornos)
JWT_SECRET=replace-with-random-secret-at-least-32-chars
JWT_ISSUER=geo-vista
JWT_AUDIENCE=geo-vista-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_MINUTES=10

# CORS (orígenes explícitos, separados por coma; nunca usar *)
CORS_ORIGINS=http://localhost:5173

# Endurecimiento HTTP
VISTAGEO_EXPOSE_DOCS=false
TRUSTED_HOSTS=localhost,127.0.0.1,::1
FORCE_HTTPS=false
HSTS_ENABLED=false
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=10485760

# Rate limit de login
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_ACCOUNT=10
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=300

# Storage/fotos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ubicaciones-fotos
VISTAGEO_PHOTO_CLEANUP_ENABLED=true
